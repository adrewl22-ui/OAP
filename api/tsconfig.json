{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@openstr/shared": ["../shared/index.ts"]
    }
  },
  "include": ["src"],
  // seed.ts is the private-fork entry point: it imports src/db/seeds/, which is
  // gitignored. It is run with tsx, never compiled, so keep it out of the build.
  "exclude": ["node_modules", "dist", "src/db/seed.ts"]
}
